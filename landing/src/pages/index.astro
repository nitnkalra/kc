---
import '../styles/global.css';
import kc from '../data/kc.json';
// Generated by kc/publish_site.py
import leaderboard from '../data/leaderboard.json';
import sessionLog from '../data/sessions.json';
import lastSeason from '../data/last_season.json';
import Program from '../components/Program.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logo = `${base}logo.png`;

const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');

// Stats are derived from the session log (single source of truth)
type Topic = { title: string; category?: string | null };
type Session = { title: string; program: string; season: number | null; category?: string | null; topics?: Topic[] };
const sessions = sessionLog.sessions as Session[];
const CATS = sessionLog.categories;
const season = sessionLog.currentSeason;
const topicsOf = (s: Session): Topic[] =>
  s.program === 'decode-it' ? s.topics ?? [] : [{ title: s.title, category: s.category }];
const viewStats = (list: Session[]) => {
  const topics = list.flatMap(topicsOf);
  return {
    sessions: list.length,
    topics: topics.length,
    categories: CATS.map((c) => [c, topics.filter((t) => t.category === c).length] as [string, number]),
  };
};
const programs = kc.programs.map((p) => {
  const own = sessions.filter((s) => s.program === p.id);
  return {
    meta: p,
    views: [
      { key: 'season', label: 'This Season', ...viewStats(own.filter((s) => s.season === season)) },
      { key: 'all', label: 'All Time', ...viewStats(own) },
    ],
  };
});

// Hero circles: all-time topics per category (Tech Tuesdays + DECODE-iT)
const allTime = viewStats(sessions);
const orbit = allTime.categories.map(([name, value], i, arr) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / arr.length;
  return { name, value, x: 50 + 38 * Math.cos(a), y: 50 + 38 * Math.sin(a) };
});

// Current season leaderboard (top 10)
// leaderboard.json = KC output file (outputs/leaderboard.json), copied as-is
const board = [...leaderboard.data].sort((a, b) => b.score - a.score).slice(0, 10);

// Simple points calculator fields
const attBands = kc.scoring.attendanceBands.filter(([, p]) => p > 0);
const calcFields = [
  { key: 'attended', icon: '🎧', label: 'Sessions attended', hint: 'Include DECODE-iT sessions where you spoke' },
  { key: 'feedback', icon: '💬', label: 'Feedback forms submitted', hint: `${kc.scoring.feedback} pts each` },
  { key: 'tt', icon: '🎤', label: 'Tech Tuesday talks given', hint: `${kc.scoring.presentation} pts each` },
  { key: 'decode', icon: '🧩', label: 'DECODE-iT talks given', hint: `${kc.scoring.decodePool} pts shared among speakers` },
  { key: 'streak', icon: '🔥', label: 'Back-to-back pairs', hint: '3 sessions in a row = 2 pairs' },
];
const maxScore = board[0]?.score ?? 1;
const rowStyle = [
  'ring-1 ring-amber-300/50 bg-amber-300/[0.06]',
  'ring-1 ring-slate-300/40 bg-slate-300/[0.05]',
  'ring-1 ring-orange-400/40 bg-orange-400/[0.05]',
];

// Last season winners (top 3)
const last = lastSeason;
const winnerStyle = ['md:order-2 md:mb-8 md:py-12 ring-1 ring-amber-300/40', 'md:order-1 ring-1 ring-slate-300/30', 'md:order-3 ring-1 ring-orange-400/30'];
const winnerLabel = ['Champion', 'Runner-up', '2nd Runner-up'];
const winnerGlow = ['rgb(245 158 11 / 0.35)', 'rgb(203 213 225 / 0.25)', 'rgb(234 88 12 / 0.3)'];

const insights = [
  { id: 'chart-feedback', title: 'Feedback per Session' },
  { id: 'chart-attendance', title: 'Attendance vs Capacity' },
  { id: 'chart-monthly', title: 'Sessions per Month' },
];

const nav = [
  ['Tech Tuesdays', '#tech-tuesdays'],
  ['DECODE-iT', '#decode-it'],
  ['Leaderboard', '#leaderboard'],
  ['Points', '#points'],
  ['Insights', '#insights'],
  ['Winners', '#winners'],
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Knowledge Club | Learn. Share. Grow.</title>
    <meta name="description" content="Knowledge Club: Tech Tuesdays, DECODE-iT, leaderboard, points and community insights." />
    <meta property="og:title" content="Knowledge Club" />
    <meta property="og:image" content={logo} />
    <link rel="icon" href={logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-ink font-sans text-slate-300 antialiased overflow-x-hidden">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grid-overlay" aria-hidden="true"></div>

    <!-- NAV -->
    <header id="nav" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <a href={base} aria-label="Knowledge Club home"><img src={logo} alt="Knowledge Club" class="h-8 w-auto md:h-9" /></a>
        <ul class="hidden items-center gap-7 text-sm font-medium lg:flex">
          {nav.map(([l, h]) => <li><a href={h} class="text-white/70 transition hover:text-white">{l}</a></li>)}
        </ul>
        <button id="menu-btn" class="lg:hidden text-white text-2xl" aria-label="Open menu">☰</button>
      </nav>
      <div id="mobile-menu" class="glass mx-4 hidden rounded-2xl p-4 lg:hidden">
        {nav.map(([l, h]) => <a href={h} class="block rounded-lg px-3 py-2 text-white/80 hover:bg-white/5">{l}</a>)}
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="relative mx-auto grid min-h-screen max-w-7xl items-center gap-12 px-6 pt-28 pb-16 lg:grid-cols-2">
        <div class="reveal">
          <span class="glass inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium text-kc-200">
            <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
            Season {season} is live
          </span>
          <h1 class="mt-6 font-display text-6xl font-bold leading-[1.02] tracking-tight text-white md:text-8xl">
            Knowledge<br /><span class="text-gradient">Club</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-400">
            Learn. Share. Grow together. A collaborative community driving curiosity, innovation and cross-functional knowledge sharing.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="#tech-tuesdays" class="btn-primary">Explore Sessions →</a>
            <a href="#leaderboard" class="btn-ghost">Leaderboard</a>
          </div>
        </div>

        <!-- Combined topics by domain (Tech Tuesdays + DECODE-iT) -->
        <div class="reveal relative mx-auto aspect-square w-full max-w-lg">
          <div class="absolute inset-[12%] rounded-full bg-kc-600/30 blur-3xl"></div>
          <div class="absolute inset-[6%] rounded-full border border-dashed border-kc-400/30 animate-[spin_50s_linear_infinite]"></div>
          <div class="absolute inset-[26%] rounded-full border border-kc-300/15"></div>
          <div class="absolute left-1/2 top-1/2 flex h-36 w-36 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center rounded-full bg-gradient-to-br from-kc-400 to-kc-700 text-center shadow-[0_0_80px_rgba(124,77,255,0.55)] ring-8 ring-kc-500/20 md:h-44 md:w-44">
            <span class="font-display text-5xl font-bold text-white md:text-6xl" data-count={allTime.sessions}>0</span>
            <span class="mt-1 text-[11px] font-semibold uppercase tracking-widest text-kc-200">Sessions held</span>
          </div>
          {orbit.map((o, i) => (
            <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${o.x}%;top:${o.y}%`}>
              <div class="float glass flex h-24 w-24 flex-col items-center justify-center rounded-full text-center ring-1 ring-kc-400/30 md:h-28 md:w-28" style={`animation-delay:-${i * 1.5}s`}>
                <span class="font-display text-3xl font-bold text-gradient" data-count={o.value}>0</span>
                <span class="px-2 text-[10px] font-medium leading-tight text-slate-300">{o.name}</span>
              </div>
            </div>
          ))}
          <p class="absolute inset-x-0 -bottom-4 text-center text-xs text-slate-500">All-time topics by category · Tech Tuesdays + DECODE-iT</p>
        </div>
      </section>

      <!-- ABOUT -->
      <section id="about" class="mx-auto max-w-7xl px-6 py-24">
        <div class="reveal mx-auto max-w-3xl text-center">
          <span class="eyebrow">About us</span>
          <h2 class="section-title">Where curiosity meets <span class="text-gradient">community</span></h2>
          <p class="mt-6 text-lg leading-relaxed text-slate-400">{kc.about}</p>
          <p class="mt-4 leading-relaxed text-slate-500">{kc.mission}</p>
        </div>
      </section>

      <!-- PROGRAMS -->
      {programs.map((p, i) => <Program program={p.meta} views={p.views} reverse={i % 2 === 1} />)}

      <!-- LEADERBOARD -->
      <section id="leaderboard" class="mx-auto max-w-4xl px-6 py-24">
        <div class="reveal text-center">
          <span class="eyebrow">Top 10</span>
          <h2 class="section-title">Leader<span class="text-gradient">board</span></h2>
          <p class="mx-auto mt-4 max-w-2xl text-slate-400">
            Celebrating our speakers and peers, ranked by session delivery, active attendance and feedback contributions.
          </p>
        </div>

        {board.length ? (
          <ol class="reveal mt-12 space-y-3">
            {board.map((p, i) => (
              <li class:list={['glass flex items-center gap-4 rounded-2xl px-5 py-4 transition hover:bg-white/[0.04]', rowStyle[i]]}>
                <span class="flex w-10 shrink-0 justify-center">
                  {i < 3 ? <span class={`medal medal-${i + 1}`}>{i + 1}</span> : <span class="font-display text-lg font-bold text-slate-500">{i + 1}</span>}
                </span>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-kc-500/20 text-xs font-bold text-kc-200">{initials(p.name)}</span>
                <span class="w-40 shrink-0 truncate font-medium text-white md:w-56">{p.name}</span>
                <div class="hidden h-2 flex-1 overflow-hidden rounded-full bg-white/5 sm:block">
                  <div class="bar h-full rounded-full bg-gradient-to-r from-kc-400 to-fuchsia-400" style={`width:${(p.score / maxScore) * 100}%`}></div>
                </div>
                <span class="ml-auto font-display text-lg font-semibold text-kc-300">{p.score}</span>
              </li>
            ))}
          </ol>
        ) : (
          <div class="reveal glass mt-12 rounded-2xl p-10 text-center">
            <p class="text-4xl">🏁</p>
            <p class="mt-3 font-display text-xl font-semibold text-white">The race has just begun</p>
            <p class="mt-1 text-sm text-slate-500">Rankings will appear after the first sessions.</p>
          </div>
        )}
      </section>

      <!-- POINTS -->
      <section id="points" class="mx-auto max-w-7xl px-6 py-24">
        <div class="reveal text-center">
          <span class="eyebrow">How scoring works</span>
          <h2 class="section-title">Points <span class="text-gradient">Distribution</span></h2>
          <p class="mx-auto mt-4 max-w-2xl text-slate-400">Points are awarded to encourage active participation and recognize contributions across Knowledge Club activities.</p>
        </div>
        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {kc.points.map((p) => (
            <article class="reveal glass relative overflow-hidden rounded-2xl p-6 text-center transition hover:-translate-y-1">
              <div class="absolute -top-10 -right-10 h-28 w-28 rounded-full bg-kc-500/20 blur-2xl"></div>
              <div class="text-3xl">{p.icon}</div>
              <p class="mt-4 font-display text-4xl font-bold text-gradient">{p.value}</p>
              <p class="text-xs uppercase tracking-widest text-slate-500">points</p>
              <h3 class="mt-4 font-medium text-white">{p.activity}</h3>
              {p.note && <p class="mt-1 text-xs text-slate-500">{p.note}</p>}
            </article>
          ))}
        </div>

        <!-- Points calculator -->
        <div id="calc" class="reveal glass mt-10 grid gap-8 rounded-3xl p-6 md:p-10 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <h3 class="font-display text-2xl font-bold text-white">Points <span class="text-gradient">Calculator</span></h3>
            <p class="mt-1 text-sm text-slate-500">Tap + / − to estimate your season score.</p>
            <div class="mt-6 space-y-3">
              {calcFields.map((f) => (
                <div class="flex flex-wrap items-center gap-3 rounded-xl bg-white/[0.03] px-4 py-3">
                  <span class="text-xl">{f.icon}</span>
                  <div class="min-w-44 flex-1">
                    <p class="text-sm font-medium text-white">{f.label}</p>
                    <p class="text-xs text-slate-500">{f.hint}</p>
                  </div>
                  {f.key === 'attended' && (
                    <select class="calc-input text-xs" data-attlvl aria-label="How much of each session you attended">
                      {attBands.map(([t, p], i) => <option value={p} selected={i === 0}>{t}%+ of session · {p} pts</option>)}
                    </select>
                  )}
                  {f.key === 'decode' && (
                    <label class="flex items-center gap-2 text-xs text-slate-400">Speakers
                      <input type="number" min="1" value="4" class="calc-input w-14" data-speakers />
                    </label>
                  )}
                  <div class="flex items-center gap-1">
                    <button type="button" class="calc-btn" data-step="-1" aria-label="Decrease">−</button>
                    <input type="number" min="0" value="0" class="calc-input w-14" data-k={f.key} aria-label={f.label} />
                    <button type="button" class="calc-btn" data-step="1" aria-label="Increase">+</button>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="flex flex-col justify-center rounded-2xl bg-gradient-to-br from-kc-500 to-kc-700 p-8 text-center lg:sticky lg:top-24 lg:self-start">
            <p class="text-xs font-semibold uppercase tracking-widest text-kc-200">Estimated score</p>
            <p id="calc-total" class="mt-2 font-display text-6xl font-bold text-white">0</p>
            <p class="text-sm text-kc-200">points</p>
            <dl class="mt-6 space-y-1 text-left text-sm">
              {[['att', 'Attendance'], ['fb', 'Feedback'], ['pres', 'Presentation'], ['bonus', 'Consecutive bonus']].map(([k, l]) => (
                <div class="flex justify-between border-b border-white/10 py-1"><dt class="text-kc-200">{l}</dt><dd class="font-semibold text-white" id={`b-${k}`}>0</dd></div>
              ))}
            </dl>
            <button id="calc-reset" type="button" class="mx-auto mt-6 rounded-full border border-white/30 px-5 py-2 text-sm text-white transition hover:bg-white/10">Reset</button>
          </div>
        </div>

      </section>

      <!-- INSIGHTS -->
      <section id="insights" class="mx-auto max-w-7xl px-6 py-24">
        <div class="reveal text-center">
          <span class="eyebrow">Data stories</span>
          <h2 class="section-title">Knowledge Club <span class="text-gradient">Insights</span></h2>
        </div>
        <div class="mt-14 grid gap-6 lg:grid-cols-3">
          {insights.map((c) => (
            <article class="reveal glass flex flex-col rounded-2xl p-6">
              <h3 class="mb-4 font-display text-lg font-semibold text-white">{c.title}</h3>
              <div class="relative h-60"><canvas id={c.id} aria-label={c.title}></canvas></div>
            </article>
          ))}
        </div>
      </section>

      <!-- LAST SEASON WINNERS -->
      <section id="winners" class="mx-auto max-w-6xl px-6 py-24">
        <div class="reveal text-center">
          <span class="eyebrow">Hall of fame</span>
          <h2 class="section-title">Season {last.season} <span class="text-gradient">Winners</span></h2>
        </div>
        <div class="mt-14 grid items-end gap-6 md:grid-cols-3">
          {last.winners.slice(0, 3).map((w, i) => (
            <article class:list={['reveal glass relative flex flex-col items-center overflow-hidden rounded-3xl p-8 text-center', winnerStyle[i]]}>
              <div class="absolute -top-16 h-44 w-44 rounded-full blur-3xl" style={`background:${winnerGlow[i]}`}></div>
              {i === 0 && <span class="relative text-4xl">🏆</span>}
              <span class={`medal medal-lg medal-${i + 1} relative mt-6`}>{i + 1}</span>
              <div class="relative mt-6 flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-kc-400 to-kc-700 font-display text-2xl font-bold text-white">{initials(w.name)}</div>
              <h3 class="relative mt-4 font-display text-xl font-semibold text-white">{w.name}</h3>
              <p class="relative mt-1 font-display text-2xl font-bold text-gradient">{w.score} pts</p>
              <p class="relative mt-1 text-xs uppercase tracking-widest text-slate-500">{winnerLabel[i]}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-5xl px-6 pb-24">
        <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-kc-500 to-kc-700 p-10 text-center md:p-16">
          <div class="absolute -top-20 -left-20 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
          <h2 class="relative font-display text-3xl font-bold text-white md:text-4xl">Have something to share?</h2>
          <p class="relative mx-auto mt-4 max-w-xl text-kc-200">Pick a topic, take the stage on Tech Tuesday and climb the leaderboard.</p>
          <a href="#points" class="relative mt-8 inline-flex rounded-full bg-white px-7 py-3 font-semibold text-kc-700 transition hover:scale-105">See how to earn points</a>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/5">
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-slate-500 md:flex-row">
        <img src={logo} alt="Knowledge Club" class="h-7 w-auto opacity-80" />
        <p>© {new Date().getFullYear()} Knowledge Club · Learn. Share. Grow.</p>
      </div>
    </footer>

    <script>
      import { Chart, registerables } from 'chart.js';
      import kc from '../data/kc.json';

      Chart.register(...registerables);
      Chart.defaults.color = '#94a3b8';
      Chart.defaults.font.family = 'Inter, sans-serif';
      Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';
      Chart.defaults.plugins.legend.labels.boxWidth = 10;

      const { feedback, attendance, sessionsMonthly } = kc.insights;
      const opts = { responsive: true, maintainAspectRatio: false };

      const charts: Record<string, () => void> = {
        'chart-feedback': () => new Chart('chart-feedback', {
          type: 'line',
          data: {
            labels: feedback.labels,
            datasets: [
              { label: 'Feedback signals', data: feedback.signals, borderColor: '#9b7bff', backgroundColor: 'rgba(155,123,255,0.15)', fill: true, tension: 0.4 },
              { label: 'Impressed', data: feedback.impressed, borderColor: '#f472b6', tension: 0.4 },
            ],
          },
          options: opts,
        }),
        'chart-attendance': () => new Chart('chart-attendance', {
          type: 'bar',
          data: {
            labels: attendance.labels,
            datasets: [
              { label: 'Attended', data: attendance.actual, backgroundColor: '#7c4dff', borderRadius: 6, grouped: false, order: 1 },
              { label: 'Capacity', data: attendance.capacity, backgroundColor: 'rgba(255,255,255,0.06)', borderRadius: 6, grouped: false, order: 2 },
            ],
          },
          options: opts,
        }),
        'chart-monthly': () => new Chart('chart-monthly', {
          type: 'bar',
          data: {
            labels: sessionsMonthly.labels,
            datasets: [{ label: 'Sessions', data: sessionsMonthly.values, backgroundColor: ['#b9a2ff', '#9b7bff', '#7c4dff', '#6a2cff'], borderRadius: 8 }],
          },
          options: { ...opts, plugins: { legend: { display: false } } },
        }),
      };

      // ---------------------------------------------------------------
      // Points calculator - mirrors kc/src/processor.py + config.py
      //  - Attendance: band pts per session attended
      //  - Feedback: 25 per form (only for sessions attended)
      //  - Tech Tuesday talk: 100 flat
      //  - DECODE-iT talk: round(100 / speakers)
      //  - +5 per back-to-back pair of attended sessions
      // ---------------------------------------------------------------
      const S = kc.scoring;
      // Python round() = banker's rounding (e.g. 12.5 -> 12)
      const pyRound = (x: number) => {
        const f = Math.floor(x);
        return Math.abs(x - f - 0.5) < 1e-9 ? (f % 2 === 0 ? f : f + 1) : Math.round(x);
      };

      const calc = document.getElementById('calc')!;
      const field = (k: string) => calc.querySelector<HTMLInputElement>(`[data-k=${k}]`)!;
      const val = (k: string) => Math.max(0, Math.floor(Number(field(k).value) || 0));
      const lvl = calc.querySelector<HTMLSelectElement>('[data-attlvl]')!;
      const spk = calc.querySelector<HTMLInputElement>('[data-speakers]')!;

      const update = () => {
        const attended = val('attended');
        // Keep inputs realistic: feedback <= attended, pairs <= attended - 1
        const feedback = Math.min(val('feedback'), attended);
        const streak = Math.min(val('streak'), Math.max(0, attended - 1));
        field('feedback').value = String(feedback);
        field('streak').value = String(streak);

        const speakers = Math.max(1, Math.floor(Number(spk.value) || 1));
        const att = attended * Number(lvl.value);
        const fb = feedback * S.feedback;
        const pres = val('tt') * S.presentation + val('decode') * pyRound(S.decodePool / speakers);
        const bonus = streak * S.consecutiveBonus;

        const set = (id: string, v: number) => (document.getElementById(id)!.textContent = v.toLocaleString());
        set('b-att', att); set('b-fb', fb); set('b-pres', pres); set('b-bonus', bonus);
        set('calc-total', att + fb + pres + bonus);
      };

      calc.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('.calc-btn');
        if (!btn) return;
        const inp = btn.parentElement!.querySelector<HTMLInputElement>('input')!;
        inp.value = String(Math.max(0, (Number(inp.value) || 0) + Number(btn.dataset.step)));
        update();
      });
      calc.addEventListener('input', update);
      calc.addEventListener('change', update);
      document.getElementById('calc-reset')!.addEventListener('click', () => {
        calc.querySelectorAll<HTMLInputElement>('[data-k]').forEach((i) => (i.value = '0'));
        lvl.selectedIndex = 0;
        spk.value = '4';
        update();
      });
      update();

      // This Season / All Time tabs
      document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
        box.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) =>
          btn.addEventListener('click', () => {
            box.querySelectorAll('[data-tab]').forEach((b) => b.classList.toggle('tab-active', b === btn));
            box.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
              const show = p.dataset.panel === btn.dataset.tab;
              p.classList.toggle('hidden', !show);
              if (show) p.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            });
          }),
        );
      });

      // Count-up for stats
      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min((t - t0) / 1400, 1);
          el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))).toLocaleString();
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      // Reveal on scroll + lazy chart init
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add('is-visible');
          el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
          const canvas = el.querySelector('canvas');
          if (canvas && charts[canvas.id]) { charts[canvas.id](); delete charts[canvas.id]; }
          io.unobserve(el);
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Nav background on scroll
      const nav = document.getElementById('nav')!;
      const onScroll = () => nav.classList.toggle('glass', window.scrollY > 20);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Mobile menu
      const menu = document.getElementById('mobile-menu')!;
      document.getElementById('menu-btn')!.addEventListener('click', () => menu.classList.toggle('hidden'));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
    </script>
  </body>
</html>
